+bool common_prompt_checkpoint::update_tgt_at(
+        llama_context * ctx,
+        llama_seq_id seq_id,
+        llama_pos pos_max) {
+    const size_t ckpt_size = llama_state_seq_get_data_at(ctx, nullptr, 0, seq_id, pos_max);
+    if (ckpt_size == 0) {
+        return false;
+    }
+
+    data_tgt.resize(ckpt_size);
+
+    const size_t n = llama_state_seq_get_data_at(ctx, data_tgt.data(), ckpt_size, seq_id, pos_max);
+    if (n != ckpt_size) {
+        data_tgt.clear();
+        return false;
+    }
+
+    return true;
+}
