+// the recurrent memory that holds the whole PARTIAL_ONLY state of ctx, nullptr for any other memory layout
+// exact type match: subclasses (e.g. llama_memory_hybrid_idx) may write more than mem_recr under PARTIAL_ONLY
+static llama_memory_recurrent * llama_state_at_mem(llama_context * ctx) {
+    llama_memory_i * mem = ctx->get_memory();
+    if (mem == nullptr) {
+        return nullptr;
+    }
+
+    llama_memory_recurrent * mem_recr = nullptr;
+    if (typeid(*mem) == typeid(llama_memory_recurrent)) {
+        mem_recr = static_cast<llama_memory_recurrent *>(mem);
+    } else if (typeid(*mem) == typeid(llama_memory_hybrid)) {
+        mem_recr = static_cast<llama_memory_hybrid *>(mem)->get_mem_recr();
+    }
+
+    return mem_recr && mem_recr->n_rs_seq > 0 ? mem_recr : nullptr;
+}
+
+bool llama_state_seq_can_get_at(llama_context * ctx) {
+    return llama_state_at_mem(ctx) != nullptr;
+}
+
+size_t llama_state_seq_get_data_at(llama_context * ctx, uint8_t * dst, size_t size, llama_seq_id seq_id, llama_pos pos_max) {
+    llama_memory_recurrent * mem = llama_state_at_mem(ctx);
+    if (mem == nullptr || !mem->state_at_begin(seq_id, pos_max)) {
+        return 0;
+    }
+
+    size_t res;
+    if (dst == nullptr) {
+        res = ctx->state_seq_get_size(seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    } else {
+        ctx->synchronize();
+        res = ctx->state_seq_get_data(seq_id, dst, size, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    }
+
+    mem->state_at_end();
+
+    return res;
+}
