+void llama_memory_recurrent::rs_record(const llama_ubatch & ubatch) {
+    if (n_rs_seq == 0) {
+        return;
+    }
+
+    for (uint32_t s = 0; s < ubatch.n_seqs; ++s) {
+        const uint32_t i = s*ubatch.n_seq_tokens;
+
+        for (int32_t j = 0; j < ubatch.n_seq_id[i]; ++j) {
+            const llama_seq_id seq_id = ubatch.seq_id[i][j];
+            const int32_t      tail   = cells[seq_id].tail;
+
+            rs_last[seq_id] = { tail, tail >= 0 ? cells[tail].pos : -1, ubatch.n_seq_tokens };
+        }
+    }
+}
+
+bool llama_memory_recurrent::state_at_begin(llama_seq_id seq_id, llama_pos pos_max) {
+    // non-causal graphs write only plane 0 (see lfm2.cpp), so there is nothing to read from the other planes
+    if (!hparams.causal_attn || seq_id < 0 || (uint32_t) seq_id >= n_seq_max) {
+        return false;
+    }
+
+    const int32_t tail = cells[seq_id].tail;
+    if (tail < 0) {
+        return false;
+    }
+
+    const auto & cell = cells[tail];
+    const auto & last = rs_last[seq_id];
+
+    // the planes are valid only while the cell still holds the output of the last ubatch of this seq:
+    //   not moved, not rolled back, not shared and without a pending rollback
+    if (last.tail != tail || last.pos != cell.pos || cell.src != tail || cell.seq_id.size() != 1 || rs_idx[seq_id] != 0) {
+        return false;
+    }
+
+    // plane k holds the state k tokens back, written only for k < min(n_seq_tokens, 1 + n_rs_seq)
+    const llama_pos k = cell.pos - pos_max;
+    if (k < 0 || k >= (llama_pos) std::min(last.n_seq_tokens, n_rs_seq + 1)) {
+        return false;
+    }
+
+    state_at_seq = seq_id;
+    state_at_k   = (uint32_t) k;
+
+    return true;
+}
+
+void llama_memory_recurrent::state_at_end() {
+    state_at_seq = -1;
+}
