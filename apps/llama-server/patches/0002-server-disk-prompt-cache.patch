diff --git a/tools/server/server-prompt-disk.cpp b/tools/server/server-prompt-disk.cpp
new file mode 100644
index 000000000..03286781c
--- /dev/null
+++ b/tools/server/server-prompt-disk.cpp
@@ -0,0 +1,925 @@
+#include "server-prompt-disk.h"
+
+#include "build-info.h"
+#include "common.h"
+#include "llama.h"
+#include "log.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+
+#ifndef _WIN32
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+// Only the state blobs move to disk: the token list, the lora config and the checkpoint positions
+// stay resident so choosing a state never needs to touch the disk.
+//
+// File layout: header, token list, lora scales, target state, draft state, checkpoints (each a
+// header and its data), then a trailer holding the payload size and an end marker. Files are
+// written under a temporary name, synced and renamed, so a file with the final name is always
+// complete.
+
+static const uint32_t SERVER_PROMPT_CACHE_FILE_MAGIC   = 0x50435331; // "PCS1"
+static const uint32_t SERVER_PROMPT_CACHE_FILE_END     = 0x45534350; // "PCSE"
+static const uint32_t SERVER_PROMPT_CACHE_FILE_VERSION = 5;
+
+static const size_t SERVER_PROMPT_CACHE_TRAILER_SIZE = sizeof(uint64_t) + sizeof(uint32_t);
+
+// never fill the filesystem: keep this much free after a write
+static const uint64_t SERVER_PROMPT_CACHE_DISK_RESERVE = 1024ull*1024ull*1024ull;
+
+struct server_prompt_spill_job {
+    std::string path;
+    uint64_t    fingerprint = 0;
+    llama_pos   pos_min     = -1;
+
+    std::vector<char>  tokens;
+    std::vector<float> lora;
+    common_state_data  main;
+    common_state_data  drft;
+
+    std::list<std::shared_ptr<const common_prompt_checkpoint>> checkpoints;
+
+    // guarded by writer_mutex
+    bool done      = false;
+    bool ok        = false;
+    bool cancelled = false;
+};
+
+struct server_prompt_file_header {
+    uint32_t magic;
+    uint32_t version;
+    uint64_t fingerprint;
+    uint64_t n_packed;
+    uint64_t n_lora;
+    uint64_t n_main;
+    uint64_t n_drft;
+    uint64_t n_ckpt;
+    uint64_t n_ckpt_b;
+    int64_t  pos_min;
+
+    uint64_t payload() const {
+        return n_packed + n_lora*sizeof(float) + n_main + n_drft + n_ckpt_b;
+    }
+};
+
+struct server_prompt_file_ckpt {
+    int64_t  n_tokens;
+    int64_t  pos_min;
+    int64_t  pos_max;
+    uint64_t size_tgt;
+    uint64_t size_dft;
+    uint64_t size_spec;
+};
+
+static_assert(sizeof(server_prompt_file_header) == 2*sizeof(uint32_t) + 8*sizeof(uint64_t), "padding in the file header");
+static_assert(sizeof(server_prompt_file_ckpt)   == 6*sizeof(uint64_t),                      "padding in the checkpoint header");
+
+// checks the header against the file size and the trailer, which catches a file cut short
+// by a crash or a full disk before anything is read from it
+static const char * server_prompt_file_check(std::ifstream & file, const server_prompt_file_header & hdr, uint64_t size_file, uint64_t fingerprint, size_t n_lora) {
+    if (hdr.magic != SERVER_PROMPT_CACHE_FILE_MAGIC || hdr.version != SERVER_PROMPT_CACHE_FILE_VERSION) {
+        return "not a state file of this version";
+    }
+
+    if (hdr.fingerprint != fingerprint || hdr.n_lora != n_lora) {
+        return "belongs to a different model or context";
+    }
+
+    if (hdr.n_packed == 0 || hdr.n_packed % sizeof(llama_token) != 0 || hdr.n_main == 0) {
+        return "has no usable state";
+    }
+
+    if (hdr.n_ckpt_b < hdr.n_ckpt * sizeof(server_prompt_file_ckpt) ||
+        sizeof(hdr) + hdr.payload() + SERVER_PROMPT_CACHE_TRAILER_SIZE != size_file) {
+        return "is truncated";
+    }
+
+    const auto pos = file.tellg();
+
+    uint64_t payload = 0;
+    uint32_t end     = 0;
+
+    file.seekg((std::streamoff) (size_file - SERVER_PROMPT_CACHE_TRAILER_SIZE));
+    file.read(reinterpret_cast<char *>(&payload), sizeof(payload));
+    file.read(reinterpret_cast<char *>(&end),     sizeof(end));
+    file.seekg(pos);
+
+    if (!file || payload != hdr.payload() || end != SERVER_PROMPT_CACHE_FILE_END) {
+        return "is truncated";
+    }
+
+    return nullptr;
+}
+
+// reads the header of the checkpoint `file` is positioned at, and checks its sizes
+static bool server_prompt_file_read_ckpt(std::ifstream & file, const server_prompt_file_header & hdr, server_prompt_file_ckpt & ckpt) {
+    if (!file.read(reinterpret_cast<char *>(&ckpt), sizeof(ckpt))) {
+        return false;
+    }
+
+    // a checkpoint without a target state would restore nothing, see common_prompt_checkpoint::load_tgt()
+    return ckpt.size_tgt  >  0 &&
+           ckpt.size_tgt  <= hdr.n_ckpt_b &&
+           ckpt.size_dft  <= hdr.n_ckpt_b - ckpt.size_tgt &&
+           ckpt.size_spec <= hdr.n_ckpt_b - ckpt.size_tgt - ckpt.size_dft;
+}
+
+static bool server_prompt_file_write(const server_prompt_spill_job & job) {
+    const std::string path_tmp = job.path + ".tmp";
+
+    FILE * f = std::fopen(path_tmp.c_str(), "wb");
+    if (!f) {
+        SRV_WRN(" - cannot open prompt cache file '%s' for writing\n", path_tmp.c_str());
+        return false;
+    }
+
+    uint64_t n_ckpt_b = 0;
+    for (const auto & ckpt : job.checkpoints) {
+        n_ckpt_b += sizeof(server_prompt_file_ckpt) + ckpt->data_tgt.size() + ckpt->data_dft.size() + ckpt->data_spec.size();
+    }
+
+    server_prompt_file_header hdr;
+    hdr.magic       = SERVER_PROMPT_CACHE_FILE_MAGIC;
+    hdr.version     = SERVER_PROMPT_CACHE_FILE_VERSION;
+    hdr.fingerprint = job.fingerprint;
+    hdr.n_packed    = job.tokens.size();
+    hdr.n_lora      = job.lora.size();
+    hdr.n_main      = job.main.size();
+    hdr.n_drft      = job.drft.size();
+    hdr.n_ckpt      = job.checkpoints.size();
+    hdr.n_ckpt_b    = n_ckpt_b;
+    hdr.pos_min     = job.pos_min;
+
+    bool ok = true;
+    const auto put = [&](const void * data, size_t size) {
+        if (ok && size > 0) {
+            ok = std::fwrite(data, 1, size, f) == size;
+        }
+    };
+
+    put(&hdr,              sizeof(hdr));
+    put(job.tokens.data(), job.tokens.size());
+    put(job.lora.data(),   job.lora.size()*sizeof(float));
+    put(job.main.data(),   job.main.size());
+    put(job.drft.data(),   job.drft.size());
+
+    for (const auto & ckpt_ptr : job.checkpoints) {
+        const auto & ckpt = *ckpt_ptr;
+
+        const server_prompt_file_ckpt ckpt_hdr = {
+            /*.n_tokens  =*/ ckpt.n_tokens,
+            /*.pos_min   =*/ ckpt.pos_min,
+            /*.pos_max   =*/ ckpt.pos_max,
+            /*.size_tgt  =*/ ckpt.data_tgt.size(),
+            /*.size_dft  =*/ ckpt.data_dft.size(),
+            /*.size_spec =*/ ckpt.data_spec.size(),
+        };
+
+        put(&ckpt_hdr, sizeof(ckpt_hdr));
+        put(ckpt.data_tgt.data(),  ckpt_hdr.size_tgt);
+        put(ckpt.data_dft.data(),  ckpt_hdr.size_dft);
+        put(ckpt.data_spec.data(), ckpt_hdr.size_spec);
+    }
+
+    const uint64_t payload = hdr.payload();
+    put(&payload, sizeof(payload));
+    put(&SERVER_PROMPT_CACHE_FILE_END, sizeof(SERVER_PROMPT_CACHE_FILE_END));
+
+    ok = ok && std::fflush(f) == 0;
+#ifndef _WIN32
+    ok = ok && fsync(fileno(f)) == 0;
+#endif
+    ok = (std::fclose(f) == 0) && ok;
+
+    if (!ok) {
+        SRV_WRN(" - failed to write prompt cache file '%s'\n", path_tmp.c_str());
+        std::remove(path_tmp.c_str());
+        return false;
+    }
+
+    std::error_code ec;
+    std::filesystem::rename(path_tmp, job.path, ec);
+    if (ec) {
+        SRV_WRN(" - cannot rename prompt cache file '%s': %s\n", path_tmp.c_str(), ec.message().c_str());
+        std::remove(path_tmp.c_str());
+        return false;
+    }
+
+#ifndef _WIN32
+    // make the rename itself durable
+    const std::string dir = std::filesystem::path(job.path).parent_path().string();
+    const int fd = open(dir.c_str(), O_RDONLY);
+    if (fd >= 0) {
+        fsync(fd);
+        close(fd);
+    }
+#endif
+
+    return true;
+}
+
+// a checkpoint without its data, which is enough for server_prompt::get_reuse(). it never leaves
+// server_prompt_disk: read_file() gives the slot the checkpoints with their data
+static std::shared_ptr<const common_prompt_checkpoint> server_prompt_ckpt_stub(int64_t n_tokens, llama_pos pos_min, llama_pos pos_max) {
+    auto res = std::make_shared<common_prompt_checkpoint>();
+    res->n_tokens = n_tokens;
+    res->pos_min  = pos_min;
+    res->pos_max  = pos_max;
+
+    return res;
+}
+
+//
+// server_prompt_cache, the parts that drive the disk tier
+//
+
+void server_prompt_cache::init_disk(const common_params & params, int32_t n_ctx, const llama_context * ctx, bool has_draft, bool has_mtmd, int32_t n_swa) {
+    // the state blobs are only meaningful for this exact model and context layout
+    // a file is identified by its path, size and modification time, so replacing a
+    // model file in place invalidates the states computed with the old one
+    const auto file_id = [](const std::string & path) -> std::string {
+        if (path.empty()) {
+            return "-";
+        }
+        std::error_code ec;
+        const auto size  = std::filesystem::file_size(path, ec);
+        const auto mtime = std::filesystem::last_write_time(path, ec);
+        return path + ":" + std::to_string(size) + ":" +
+            std::to_string((long long) mtime.time_since_epoch().count());
+    };
+
+    const auto & draft = params.speculative.draft;
+
+    // the build too: the state layout can change between versions with the same sizes
+    std::string sig =
+        std::string(llama_build_info()) + "|" +
+        file_id(params.model.path) + "|" +
+        file_id(draft.mparams.path) + "|" +
+        file_id(params.mmproj.path) + "|" +
+        std::to_string(n_ctx) + "|" +
+        std::to_string(params.n_parallel) + "|" +
+        std::to_string(params.kv_unified) + "|" +
+        std::to_string(params.kv_unified_per_slot) + "|" +
+        std::to_string(params.swa_full) + "|" +
+        std::to_string((int) params.flash_attn_type) + "|" +
+        std::to_string((int) params.cache_type_k) + "|" +
+        std::to_string((int) params.cache_type_v) + "|" +
+        std::to_string((int) draft.cache_type_k) + "|" +
+        std::to_string((int) draft.cache_type_v) + "|" +
+        std::to_string(has_draft) + "|" +
+        std::to_string(params.rope_freq_base) + "|" +
+        std::to_string(params.rope_freq_scale) + "|" +
+        std::to_string(params.yarn_ext_factor) + "|" +
+        std::to_string(params.yarn_attn_factor) + "|" +
+        std::to_string(params.yarn_beta_fast) + "|" +
+        std::to_string(params.yarn_beta_slow) + "|" +
+        std::to_string(params.yarn_orig_ctx);
+
+    for (const auto & la : params.lora_adapters) {
+        sig += "|lora:" + file_id(la.path) + ":" + std::to_string(la.scale);
+    }
+
+    for (const auto & cv : params.control_vectors) {
+        sig += "|cvec:" + file_id(cv.fname) + ":" + std::to_string(cv.strength);
+    }
+    sig += "|" + std::to_string(params.control_vector_layer_start) + ":" +
+        std::to_string(params.control_vector_layer_end);
+
+    for (const auto & kvo : params.kv_overrides) {
+        if (kvo.key[0] == 0) {
+            continue;
+        }
+        sig += "|kv:" + std::string(kvo.key) + "=" + std::to_string((int) kvo.tag) + ":";
+        switch (kvo.tag) {
+            case LLAMA_KV_OVERRIDE_TYPE_INT:   sig += std::to_string(kvo.val_i64);  break;
+            case LLAMA_KV_OVERRIDE_TYPE_FLOAT: sig += std::to_string(kvo.val_f64);  break;
+            case LLAMA_KV_OVERRIDE_TYPE_BOOL:  sig += std::to_string(kvo.val_bool); break;
+            case LLAMA_KV_OVERRIDE_TYPE_STR:   sig += std::string(kvo.val_str);     break;
+        }
+    }
+
+    uint64_t fingerprint = 0xcbf29ce484222325ull;
+    for (const char c : sig) {
+        fingerprint = (fingerprint ^ (uint8_t) c) * 0x100000001b3ull;
+    }
+
+    disk = std::make_shared<server_prompt_disk>();
+
+    disk->dir         = params.cache_dir;
+    disk->limit_size  = params.cache_disk_mib < 0 ? 0 : 1024ull*1024ull*params.cache_disk_mib;
+    disk->fingerprint = fingerprint;
+    disk->has_mtmd    = has_mtmd;
+    disk->n_swa       = n_swa;
+    disk->lora_base   = params.lora_adapters;
+
+    const size_t n_adopted = disk->index(ctx);
+    if (n_adopted > 0) {
+        SRV_WRN("adopted %zu prompt cache state(s) from an earlier run (%.3f MiB)\n",
+                n_adopted, disk->size() / (1024.0 * 1024.0));
+    }
+
+    SRV_TRC("prompt cache spills to '%s', disk limit: %s\n", disk->dir.c_str(),
+            params.cache_disk_mib < 0 ? "no limit" : (std::to_string(params.cache_disk_mib) + " MiB").c_str());
+}
+
+void server_prompt_cache::flush_disk() {
+    if (!disk) {
+        return;
+    }
+
+    const int64_t t_start_us = ggml_time_us();
+
+    const size_t n_states = states.size();
+
+    while (!states.empty()) {
+        disk->put(std::move(states.front()));
+        states.pop_front();
+    }
+
+    disk->flush();
+
+    if (n_states > 0) {
+        SRV_WRN("prompt cache: wrote %zu state(s) to disk, %zu on disk, %.3f MiB, %.2f ms\n",
+                n_states, disk->entries.size(), disk->size() / (1024.0 * 1024.0), (ggml_time_us() - t_start_us) / 1000.0);
+    }
+}
+
+//
+// server_prompt_disk
+//
+
+server_prompt_disk::~server_prompt_disk() {
+    {
+        std::unique_lock<std::mutex> lock(writer_mutex);
+        writer_stop = true;
+    }
+    writer_cv.notify_all();
+
+    // the writer finishes the queued files first
+    if (writer.joinable()) {
+        writer.join();
+    }
+}
+
+// the tokens update_slots() would keep if this prompt were the slot's: on recurrent or SWA memory, a
+// state whose pos_min is too far past the divergence can only be rewound by restoring a checkpoint
+int server_prompt_disk::n_reusable(const server_prompt & prompt, llama_pos pos_min, const server_tokens & tokens_new) const {
+    const int n_prefix = prompt.tokens.get_common_prefix(tokens_new);
+    if (n_prefix == 0) {
+        return 0;
+    }
+
+    const int n_past = prompt.get_reuse(n_prefix, n_prefix < (int) tokens_new.size(), n_swa, pos_min).n_past;
+
+    // at least one token is evaluated [TAG_PROMPT_LOGITS]
+    return std::min(n_past, (int) tokens_new.size() - 1);
+}
+
+void server_prompt_disk::writer_start() {
+    if (!writer.joinable()) {
+        writer = std::thread([this]() { writer_loop(); });
+    }
+}
+
+void server_prompt_disk::writer_loop() {
+    while (true) {
+        std::shared_ptr<server_prompt_spill_job> job;
+
+        {
+            std::unique_lock<std::mutex> lock(writer_mutex);
+            writer_cv.wait(lock, [this]() { return writer_stop || !writer_queue.empty(); });
+
+            if (writer_queue.empty()) {
+                return;
+            }
+
+            job = writer_queue.front();
+
+            if (job->cancelled) {
+                writer_queue.pop_front();
+                job->done = true;
+                writer_cv_done.notify_all();
+                continue;
+            }
+        }
+
+        const int64_t t_start_us = ggml_time_us();
+        const bool ok = server_prompt_file_write(*job);
+        const double  t_ms = (ggml_time_us() - t_start_us) / 1000.0;
+
+        {
+            std::unique_lock<std::mutex> lock(writer_mutex);
+            writer_queue.pop_front();
+
+            if (ok && job->cancelled) {
+                std::remove(job->path.c_str());
+            }
+
+            if (ok) {
+                const double size_mib = (job->tokens.size() + job->main.size() + job->drft.size()) / (1024.0 * 1024.0);
+                SRV_INF(" - wrote prompt cache file '%s' (%.3f MiB + %zu checkpoints, %.2f ms)\n",
+                        job->path.c_str(), size_mib, job->checkpoints.size(), t_ms);
+            }
+
+            job->done = true;
+            job->ok   = ok;
+
+            // the file holds it now
+            job->tokens = {};
+            job->lora   = {};
+            job->main   = {};
+            job->drft   = {};
+            job->checkpoints.clear();
+        }
+
+        writer_cv_done.notify_all();
+    }
+}
+
+void server_prompt_disk::writer_wait(const std::shared_ptr<server_prompt_spill_job> & job) {
+    std::unique_lock<std::mutex> lock(writer_mutex);
+    writer_cv_done.wait(lock, [&job]() { return job->done; });
+}
+
+// A previous run's state files are still valid if they describe the same model and context,
+// so adopt them instead of decoding those prompts again. Anything foreign or unreadable is
+// deleted: a crash skips the shutdown flush, and the directory must not grow without bound.
+// The directory must belong to a single server for this reason.
+size_t server_prompt_disk::index(const llama_context * ctx) {
+    struct found_file {
+        std::filesystem::file_time_type mtime;
+        size_t      idx;
+        std::string path;
+    };
+
+    std::vector<found_file> found;
+
+    std::error_code ec;
+    for (std::filesystem::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec)) {
+        const std::string name = it->path().filename().string();
+
+        if (name.rfind("state-", 0) != 0) {
+            continue;
+        }
+
+        // a write that never finished
+        if (it->path().extension() == ".tmp") {
+            SRV_WRN(" - removing incomplete prompt cache file '%s'\n", it->path().string().c_str());
+            std::remove(it->path().string().c_str());
+            continue;
+        }
+
+        if (it->path().extension() != ".bin") {
+            continue;
+        }
+
+        size_t idx = 0;
+        try {
+            idx = (size_t) std::stoull(name.substr(6));
+        } catch (const std::exception &) {
+            continue;
+        }
+
+        std::error_code ec_time;
+        const auto mtime = std::filesystem::last_write_time(it->path(), ec_time);
+
+        found.push_back({ mtime, idx, it->path().string() });
+    }
+
+    if (ec) {
+        SRV_WRN(" - cannot read the prompt cache directory '%s': %s\n", dir.c_str(), ec.message().c_str());
+        return 0;
+    }
+
+    for (const auto & f : found) {
+        i_file = std::max(i_file, f.idx + 1);
+    }
+
+    // most recently used first, so the disk limit keeps the newest states
+    std::sort(found.begin(), found.end(), [](const found_file & a, const found_file & b) {
+        return a.mtime != b.mtime ? a.mtime > b.mtime : a.idx > b.idx;
+    });
+
+    std::vector<server_prompt_disk_entry> adopted;
+    size_t size_adopted = 0;
+
+    for (const auto & f : found) {
+        const std::string & path_cur = f.path;
+
+        const auto discard = [&path_cur](const char * reason) {
+            SRV_WRN(" - discarding prompt cache file '%s': %s\n", path_cur.c_str(), reason);
+            std::remove(path_cur.c_str());
+        };
+
+        std::error_code ec_size;
+        const uint64_t size_file = std::filesystem::file_size(path_cur, ec_size);
+
+        std::ifstream file(path_cur, std::ios::binary);
+        if (!file || ec_size) {
+            discard("cannot be opened");
+            continue;
+        }
+
+        server_prompt_file_header hdr;
+        if (!file.read(reinterpret_cast<char *>(&hdr), sizeof(hdr))) {
+            discard("is truncated");
+            continue;
+        }
+
+        if (const char * err = server_prompt_file_check(file, hdr, size_file, fingerprint, lora_base.size())) {
+            discard(err);
+            continue;
+        }
+
+        if (limit_size > 0 && size_adopted + size_file > limit_size) {
+            discard("does not fit the prompt cache disk limit");
+            continue;
+        }
+
+        llama_tokens packed(hdr.n_packed / sizeof(llama_token));
+        file.read(reinterpret_cast<char *>(packed.data()), (std::streamsize) hdr.n_packed);
+
+        server_prompt prompt_cur;
+
+        // the adapters are the server's, the fingerprint covers them; only the scales vary
+        prompt_cur.lora = lora_base;
+        for (auto & la : prompt_cur.lora) {
+            file.read(reinterpret_cast<char *>(&la.scale), sizeof(la.scale));
+        }
+
+        file.seekg((std::streamoff) (hdr.n_main + hdr.n_drft), std::ios::cur);
+
+        // the checkpoint positions only, the data stays in the file
+        for (uint64_t i = 0; i < hdr.n_ckpt && file; ++i) {
+            server_prompt_file_ckpt ckpt;
+            if (!server_prompt_file_read_ckpt(file, hdr, ckpt)) {
+                file.setstate(std::ios::failbit);
+                break;
+            }
+
+            prompt_cur.checkpoints.push_back(server_prompt_ckpt_stub(ckpt.n_tokens, (llama_pos) ckpt.pos_min, (llama_pos) ckpt.pos_max));
+
+            file.seekg((std::streamoff) (ckpt.size_tgt + ckpt.size_dft + ckpt.size_spec), std::ios::cur);
+        }
+
+        if (!file) {
+            discard("is truncated");
+            continue;
+        }
+
+        try {
+            prompt_cur.tokens = server_tokens::deserialize(packed, has_mtmd);
+        } catch (const std::exception & err) {
+            discard(err.what());
+            continue;
+        }
+
+        // the tokens have to mean the same thing to this model as they did to the last one
+        if (!prompt_cur.tokens.validate(ctx)) {
+            discard("holds tokens this model cannot represent");
+            continue;
+        }
+
+        server_prompt_disk_entry entry;
+        entry.prompt  = std::move(prompt_cur);
+        entry.pos_min = (llama_pos) hdr.pos_min;
+        entry.path    = path_cur;
+        entry.size    = size_file;
+
+        adopted.push_back(std::move(entry));
+        size_adopted += size_file;
+    }
+
+    // the list is least recently used first
+    for (auto it = adopted.rbegin(); it != adopted.rend(); ++it) {
+        entries.push_back(std::move(*it));
+    }
+
+    return adopted.size();
+}
+
+void server_prompt_disk::put(server_prompt_cache_state && state) {
+    // finish the writes the writer is done with
+    for (auto it = entries.begin(); it != entries.end(); ) {
+        it = it->job ? reap(it, false) : std::next(it);
+    }
+
+    // a state on disk holds it already
+    for (const auto & entry : entries) {
+        if ((size_t) entry.prompt.tokens.get_common_prefix(state.prompt.tokens) == state.prompt.tokens.size() &&
+            are_lora_equal(entry.prompt.lora, state.prompt.lora)) {
+            SRV_TRC(" - prompt with length %d is already on disk, skipping\n", state.prompt.n_tokens());
+            return;
+        }
+    }
+
+    auto job = std::make_shared<server_prompt_spill_job>();
+
+    try {
+        job->tokens = state.prompt.tokens.serialize();
+    } catch (const std::exception & err) {
+        SRV_WRN(" - cannot serialize tokens for the prompt cache file: %s\n", err.what());
+        return;
+    }
+
+    for (const auto & la : state.prompt.lora) {
+        job->lora.push_back(la.scale);
+    }
+
+    size_t size_ckpt = 0;
+    for (const auto & ckpt : state.prompt.checkpoints) {
+        size_ckpt += sizeof(server_prompt_file_ckpt) + ckpt->data_tgt.size() + ckpt->data_dft.size() + ckpt->data_spec.size();
+    }
+
+    const size_t size_file = sizeof(server_prompt_file_header) + job->tokens.size() + job->lora.size()*sizeof(float) +
+        state.data.main.size() + state.data.drft.size() + size_ckpt + SERVER_PROMPT_CACHE_TRAILER_SIZE;
+
+    // checked before making room, so a state that cannot be stored never evicts the others
+    if (limit_size > 0 && size_file > limit_size) {
+        SRV_WRN(" - prompt state %.3f MiB does not fit the prompt cache disk limit %.3f MiB\n",
+                size_file / (1024.0 * 1024.0), limit_size / (1024.0 * 1024.0));
+        return;
+    }
+
+    // files still being written count against the free space too, the ones make_room() is
+    // about to delete do not
+    size_t size_pending = 0;
+    {
+        std::unique_lock<std::mutex> lock(writer_mutex);
+        for (const auto & cur : entries) {
+            if (cur.job && !cur.job->done) {
+                size_pending += cur.size;
+            }
+        }
+    }
+
+    const size_t size_freed = limit_size > 0 && size() + size_file > limit_size ? size() + size_file - limit_size : 0;
+
+    std::error_code ec;
+    const auto space = std::filesystem::space(dir, ec);
+    if (ec || space.available + size_freed < size_file + size_pending + SERVER_PROMPT_CACHE_DISK_RESERVE) {
+        SRV_WRN(" - not enough free space in '%s' for a %.3f MiB prompt state\n", dir.c_str(), size_file / (1024.0 * 1024.0));
+        return;
+    }
+
+    make_room(size_file);
+
+    job->path        = (std::filesystem::path(dir) / ("state-" + std::to_string(i_file++) + ".bin")).string();
+    job->fingerprint = fingerprint;
+    job->pos_min     = state.pos_min;
+    job->main        = std::move(state.data.main);
+    job->drft        = std::move(state.data.drft);
+    job->checkpoints = std::move(state.prompt.checkpoints);
+
+    server_prompt_disk_entry entry;
+    entry.prompt.tokens = std::move(state.prompt.tokens);
+    entry.prompt.lora   = std::move(state.prompt.lora);
+    for (const auto & ckpt : job->checkpoints) {
+        entry.prompt.checkpoints.push_back(server_prompt_ckpt_stub(ckpt->n_tokens, ckpt->pos_min, ckpt->pos_max));
+    }
+    entry.pos_min = state.pos_min;
+    entry.path    = job->path;
+    entry.size    = size_file;
+    entry.job     = job;
+
+    SRV_WRN(" - spilling prompt cache entry to disk (%d tokens, %zu checkpoints, %.3f MiB)\n",
+            entry.prompt.n_tokens(), entry.prompt.checkpoints.size(), size_file / (1024.0 * 1024.0));
+
+    entries.push_back(std::move(entry));
+
+    writer_start();
+
+    {
+        std::unique_lock<std::mutex> lock(writer_mutex);
+        writer_queue.push_back(job);
+    }
+    writer_cv.notify_one();
+}
+
+bool server_prompt_disk::load(std::list<server_prompt_cache_state> & states, std::list<server_prompt_cache_state>::const_iterator pick,
+        const server_prompt * prompt, llama_pos pos_min, const server_tokens & tokens_new, const std::vector<common_adapter_lora_info> & lora_new) {
+    // the RAM candidate wins a tie, it does not have to be read back
+    int n_best = prompt ? n_reusable(*prompt, pos_min, tokens_new) : 0;
+    if (pick != states.end()) {
+        n_best = std::max(n_best, n_reusable(pick->prompt, pick->pos_min, tokens_new));
+    }
+
+    auto it_best = entries.end();
+
+    for (auto it = entries.begin(); it != entries.end(); ++it) {
+        if (lora_should_clear_cache(it->prompt.lora, lora_new)) {
+            continue;
+        }
+
+        const int n_cur = n_reusable(it->prompt, it->pos_min, tokens_new);
+
+        SRV_TRC("   - prompt with length %7zu on disk, reusable = %7d\n", it->prompt.tokens.size(), n_cur);
+
+        if (n_cur > n_best) {
+            n_best  = n_cur;
+            it_best = it;
+        }
+    }
+
+    if (it_best == entries.end()) {
+        return false;
+    }
+
+    const int64_t t_start_us = ggml_time_us();
+
+    server_prompt_cache_state state;
+    if (!read_file(*it_best, state)) {
+        SRV_WRN("%s", " - failed to read the spilled prompt state, dropping it\n");
+
+        drop(it_best);
+
+        return false;
+    }
+
+    SRV_WRN(" - read a prompt state from disk (%d tokens, %zu checkpoints, %.3f MiB, %.2f ms)\n",
+            state.prompt.n_tokens(), state.prompt.checkpoints.size(), it_best->size / (1024.0 * 1024.0),
+            (ggml_time_us() - t_start_us) / 1000.0);
+
+    states.push_back(std::move(state));
+
+    // the file stays: a later prompt may branch from the same point, and a crash before
+    // this slot is saved again must not lose it. Mark it most recently used.
+    entries.splice(entries.end(), entries, it_best);
+
+    return true;
+}
+
+bool server_prompt_disk::read_file(const server_prompt_disk_entry & entry, server_prompt_cache_state & state) {
+    if (entry.job) {
+        writer_wait(entry.job);
+
+        if (!entry.job->ok) {
+            return false;
+        }
+    }
+
+    std::error_code ec;
+    const uint64_t size_file = std::filesystem::file_size(entry.path, ec);
+
+    std::ifstream file(entry.path, std::ios::binary);
+    if (!file || ec) {
+        SRV_WRN(" - cannot open prompt cache file '%s' for reading\n", entry.path.c_str());
+        return false;
+    }
+
+    server_prompt_file_header hdr;
+    if (!file.read(reinterpret_cast<char *>(&hdr), sizeof(hdr))) {
+        SRV_WRN(" - prompt cache file '%s' is truncated\n", entry.path.c_str());
+        return false;
+    }
+
+    if (const char * err = server_prompt_file_check(file, hdr, size_file, fingerprint, lora_base.size())) {
+        SRV_WRN(" - prompt cache file '%s' %s\n", entry.path.c_str(), err);
+        return false;
+    }
+
+    state.prompt.tokens = entry.prompt.tokens.clone();
+    state.prompt.lora   = entry.prompt.lora;
+    state.pos_min       = entry.pos_min;
+
+    state.data.main.resize(hdr.n_main);
+    state.data.drft.resize(hdr.n_drft);
+
+    // the token list and the lora config are resident
+    file.seekg((std::streamoff) (hdr.n_packed + hdr.n_lora*sizeof(float)), std::ios::cur);
+    file.read(reinterpret_cast<char *>(state.data.main.data()), (std::streamsize) hdr.n_main);
+    file.read(reinterpret_cast<char *>(state.data.drft.data()), (std::streamsize) hdr.n_drft);
+
+    for (uint64_t i = 0; i < hdr.n_ckpt && file; ++i) {
+        server_prompt_file_ckpt ckpt_hdr;
+        if (!server_prompt_file_read_ckpt(file, hdr, ckpt_hdr)) {
+            file.setstate(std::ios::failbit);
+            break;
+        }
+
+        auto ckpt_ptr = std::make_shared<common_prompt_checkpoint>();
+        auto & ckpt = *ckpt_ptr;
+
+        ckpt.n_tokens = ckpt_hdr.n_tokens;
+        ckpt.pos_min  = (llama_pos) ckpt_hdr.pos_min;
+        ckpt.pos_max  = (llama_pos) ckpt_hdr.pos_max;
+
+        ckpt.data_tgt .resize(ckpt_hdr.size_tgt);
+        ckpt.data_dft .resize(ckpt_hdr.size_dft);
+        ckpt.data_spec.resize(ckpt_hdr.size_spec);
+
+        file.read(reinterpret_cast<char *>(ckpt.data_tgt .data()), (std::streamsize) ckpt_hdr.size_tgt);
+        file.read(reinterpret_cast<char *>(ckpt.data_dft .data()), (std::streamsize) ckpt_hdr.size_dft);
+        file.read(reinterpret_cast<char *>(ckpt.data_spec.data()), (std::streamsize) ckpt_hdr.size_spec);
+
+        state.prompt.checkpoints.push_back(std::move(ckpt_ptr));
+    }
+
+    if (!file) {
+        SRV_WRN(" - prompt cache file '%s' is truncated\n", entry.path.c_str());
+        return false;
+    }
+
+    // most recently used, for the next run's adoption order
+    std::filesystem::last_write_time(entry.path, std::filesystem::file_time_type::clock::now(), ec);
+
+    return true;
+}
+
+std::list<server_prompt_disk_entry>::iterator server_prompt_disk::drop(std::list<server_prompt_disk_entry>::iterator it) {
+    bool remove_now = true;
+
+    if (it->job) {
+        std::unique_lock<std::mutex> lock(writer_mutex);
+
+        if (!it->job->done) {
+            // the writer deletes the file once it is done with it
+            it->job->cancelled = true;
+            remove_now = false;
+        } else {
+            remove_now = it->job->ok;
+        }
+    }
+
+    if (remove_now) {
+        std::remove(it->path.c_str());
+    }
+
+    return entries.erase(it);
+}
+
+std::list<server_prompt_disk_entry>::iterator server_prompt_disk::reap(std::list<server_prompt_disk_entry>::iterator it, bool wait) {
+    bool done = false;
+    bool ok   = false;
+    {
+        std::unique_lock<std::mutex> lock(writer_mutex);
+        if (wait) {
+            writer_cv_done.wait(lock, [&it]() { return it->job->done; });
+        }
+        done = it->job->done;
+        ok   = it->job->ok;
+    }
+
+    if (!done) {
+        return std::next(it);
+    }
+
+    if (!ok) {
+        SRV_WRN("%s", " - dropping a prompt cache entry whose file could not be written\n");
+        return drop(it);
+    }
+
+    it->job.reset();
+
+    // the entries this one contains were kept until its file was complete, so a crash
+    // in between does not lose both
+    for (auto cur = entries.begin(); cur != entries.end(); ) {
+        const size_t len = cur->prompt.tokens.size();
+
+        if (cur != it && len < it->prompt.tokens.size() &&
+            (size_t) cur->prompt.tokens.get_common_prefix(it->prompt.tokens) == len &&
+            are_lora_equal(cur->prompt.lora, it->prompt.lora)) {
+            SRV_TRC(" - removing obsolete cached prompt with length %zu\n", len);
+
+            cur = drop(cur);
+        } else {
+            ++cur;
+        }
+    }
+
+    return std::next(it);
+}
+
+void server_prompt_disk::flush() {
+    for (auto it = entries.begin(); it != entries.end(); ) {
+        it = it->job ? reap(it, true) : std::next(it);
+    }
+}
+
+void server_prompt_disk::make_room(size_t need) {
+    if (limit_size == 0) {
+        return;
+    }
+
+    for (auto it = entries.begin(); it != entries.end() && size() + need > limit_size; ) {
+        SRV_WRN(" - prompt cache disk limit reached, removing least recently used entry (size = %.3f MiB)\n",
+                it->size / (1024.0 * 1024.0));
+
+        it = drop(it);
+    }
+}
+
+size_t server_prompt_disk::size() const {
+    size_t res = 0;
+
+    for (const auto & entry : entries) {
+        res += entry.size;
+    }
+
+    return res;
+}
diff --git a/tools/server/server-prompt-disk.h b/tools/server/server-prompt-disk.h
new file mode 100644
index 000000000..1d31eb6c9
--- /dev/null
+++ b/tools/server/server-prompt-disk.h
@@ -0,0 +1,107 @@
+#pragma once
+
+#include "server-slot-sched.h"
+
+#include <condition_variable>
+#include <deque>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+// disk tier of the prompt cache: the states evicted from RAM are written to a directory instead of
+// being dropped, and the whole cache is written there on shutdown, so it survives a restart
+
+// a state file being written by the writer thread
+struct server_prompt_spill_job;
+
+struct server_prompt_disk_entry {
+    // the tokens, the lora config and the checkpoints without their data, enough for server_prompt::get_reuse()
+    server_prompt prompt;
+
+    // the state's pos_min as it was saved
+    llama_pos pos_min = -1;
+
+    std::string path;
+    size_t size = 0;
+
+    // set until the write of the file is seen to finish
+    std::shared_ptr<server_prompt_spill_job> job;
+};
+
+struct server_prompt_disk {
+    server_prompt_disk() = default;
+    server_prompt_disk(const server_prompt_disk &) = delete;
+    server_prompt_disk & operator=(const server_prompt_disk &) = delete;
+
+    ~server_prompt_disk();
+
+    std::string dir;
+
+    // in bytes, 0 = no limit
+    size_t limit_size = 0;
+
+    // identifies the model/context the state files belong to
+    uint64_t fingerprint = 0;
+
+    // whether the token lists may contain media chunks, needed to deserialize them
+    bool has_mtmd = false;
+
+    // n_swa for server_prompt::get_reuse()
+    int32_t n_swa = 0;
+
+    // the server's lora adapters, a state file stores only their scales
+    std::vector<common_adapter_lora_info> lora_base;
+
+    // least recently used first
+    std::list<server_prompt_disk_entry> entries;
+
+    // adopt the state files an earlier run left in `dir`. files belonging to another model or
+    // context, and unreadable ones, are deleted. returns how many entries were adopted.
+    size_t index(const llama_context * ctx);
+
+    // write a state evicted from RAM to a file, or drop it if it cannot be stored
+    void put(server_prompt_cache_state && state);
+
+    // when a state on disk keeps more of the new prompt than both the slot's own state and `pick`,
+    // read it into a new state at the end of `states` and return true
+    bool load(std::list<server_prompt_cache_state> & states, std::list<server_prompt_cache_state>::const_iterator pick,
+            const server_prompt * prompt, llama_pos pos_min, const server_tokens & tokens_new, const std::vector<common_adapter_lora_info> & lora_new);
+
+    // wait until all files are complete
+    void flush();
+
+    size_t size() const;
+
+    // how many tokens of `tokens_new` a state could keep without being decoded again
+    int n_reusable(const server_prompt & prompt, llama_pos pos_min, const server_tokens & tokens_new) const;
+
+private:
+    // read the state data and the checkpoints of `entry` into `state`. returns false if the file is unusable.
+    bool read_file(const server_prompt_disk_entry & entry, server_prompt_cache_state & state);
+
+    // drop `it` and delete its file
+    std::list<server_prompt_disk_entry>::iterator drop(std::list<server_prompt_disk_entry>::iterator it);
+
+    // finish the write of `it`'s file once the writer is done with it: drop the entry if the write
+    // failed, else drop the entries it replaces. returns the next entry.
