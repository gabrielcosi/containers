     return MMVQ_MAX_BATCH_SIZE;
 }
 
+// GGML_CUDA_MMVQ_MAX_NVFP4=<n> overrides the largest batch size that uses MMVQ for NVFP4, clamped to [0, MMVQ_MAX_BATCH_SIZE]
+static int ggml_cuda_mmvq_max_nvfp4_env() {
+    const char * env = getenv("GGML_CUDA_MMVQ_MAX_NVFP4");
+    if (env == nullptr) {
+        return -1;
+    }
+    char * end = nullptr;
+    const long value = strtol(env, &end, 10);
+    if (end == env) {
+        return -1;
+    }
+    return value < 0 ? 0 : value > MMVQ_MAX_BATCH_SIZE ? MMVQ_MAX_BATCH_SIZE : (int) value;
+}
+
 bool ggml_cuda_should_use_mmvq(enum ggml_type type, int cc, int64_t ne11) {
     if (!ggml_is_quantized(type)) {
         return false;
     }
+    if (type == GGML_TYPE_NVFP4) {
+        static const int max_nvfp4 = ggml_cuda_mmvq_max_nvfp4_env();
+        if (max_nvfp4 >= 0) {
+            return ne11 <= max_nvfp4;
+        }
+    }
