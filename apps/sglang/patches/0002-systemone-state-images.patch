@@ -106,6 +106,43 @@ class SystemOneRequest(BaseModel):
     prompt_format_version: SkipJsonSchema[Any] = None
     return_prompt_token_ids: SkipJsonSchema[Any] = None
 
+    @model_validator(mode="before")
+    @classmethod
+    def _take_state_images(cls, data: Any) -> Any:
+        # As llama.cpp's server does: the image_url parts of chat messages in the
+        # state, bare or under "messages", follow the top-level images.
+        if not isinstance(data, dict):
+            return data
+        state = data.get("state")
+        wrapped = isinstance(state, dict) and "messages" in state
+        messages = state["messages"] if wrapped else state
+        if not isinstance(messages, list):
+            return data
+        images = list(data.get("images") or [])
+        moved = False
+        out = []
+        for message in messages:
+            content = message.get("content") if isinstance(message, dict) else None
+            if not isinstance(content, list):
+                out.append(message)
+                continue
+            kept = []
+            for part in content:
+                if (
+                    isinstance(part, dict)
+                    and part.get("type") == "image_url"
+                    and "image_url" in part
+                ):
+                    images.append(part["image_url"])
+                    moved = True
+                else:
+                    kept.append(part)
+            out.append({**message, "content": kept})
+        if not moved:
+            return data
+        state = {**state, "messages": out} if wrapped else out
+        return {**data, "state": state, "images": images}
+
     @field_validator("temperature", "prompt_format_version", "return_prompt_token_ids")
     @classmethod
     def _refuse_decisions_fields(cls, value, info: ValidationInfo):
