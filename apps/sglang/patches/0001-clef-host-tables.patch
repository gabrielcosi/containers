diff --git a/python/sglang/srt/layers/host_embedding.py b/python/sglang/srt/layers/host_embedding.py
new file mode 100644
index 0000000000..7d285e030b
--- /dev/null
+++ b/python/sglang/srt/layers/host_embedding.py
@@ -0,0 +1,68 @@
+"""Embedding tables kept in host memory and gathered by the GPU in place."""
+
+from typing import Optional
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from sglang.srt.model_loader.weight_utils import default_weight_loader
+from sglang.srt.utils import set_weight_attrs
+
+
+class _CudaArray:
+    """Describes registered host memory to torch as a CUDA array."""
+
+    def __init__(self, table: torch.Tensor):
+        self.__cuda_array_interface__ = {
+            "shape": tuple(table.shape),
+            # The interface has no bfloat16, so the alias is viewed back after.
+            "typestr": f"<i{table.element_size()}",
+            # UVA gives registered host memory the same address on the device.
+            "data": (table.data_ptr(), False),
+            "strides": None,
+            "version": 3,
+        }
+
+
+class HostEmbedding(nn.Module):
+    """An embedding table in page-locked host memory, read by the GPU directly.
+
+    A lookup moves only the rows it gathers over PCIe, uses no device memory and
+    does not synchronize. This suits tables a model only gathers rows from, such
+    as the input embedding, or the LM head of a model that computes no logits.
+    Not sharded: every rank holds the whole table.
+    """
+
+    def __init__(
+        self,
+        num_embeddings: int,
+        embedding_dim: int,
+        params_dtype: Optional[torch.dtype] = None,
+    ):
+        super().__init__()
+        self.num_embeddings = num_embeddings
+        self.org_vocab_size = num_embeddings
+        self.embedding_dim = embedding_dim
+        table = torch.empty(
+            num_embeddings,
+            embedding_dim,
+            dtype=params_dtype or torch.get_default_dtype(),
+            device="cpu",
+        )
+        # Registered in place: pin_memory() would round the size up to a power of two.
+        nbytes = table.numel() * table.element_size()
+        err = torch.cuda.cudart().cudaHostRegister(table.data_ptr(), nbytes, 0)
+        if int(err) != 0:
+            raise RuntimeError(f"cudaHostRegister({nbytes} bytes) failed: {err}")
+        self.weight = nn.Parameter(table, requires_grad=False)
+        # Copies into the registered buffer in place, which device_weight aliases.
+        self.weight_loader = default_weight_loader
+        set_weight_attrs(self.weight, {"weight_loader": default_weight_loader})
+        # Not a parameter or buffer, so module moves and state dicts skip it.
+        self.device_weight = torch.as_tensor(
+            _CudaArray(table), device=torch.cuda.current_device()
+        ).view(table.dtype)
+
+    def forward(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return F.embedding(input_ids, self.device_weight)
