+    def _build_lm_head(
+        self, quant_config: Optional[QuantizationConfig], prefix: str
+    ) -> nn.Module:
+        if isinstance(self.model.embed_tokens, HostEmbedding):
+            # Never multiplied: the joint schema head computes no logits and
+            # gathers only the LM head rows of option tokens.
